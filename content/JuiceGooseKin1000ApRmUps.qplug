-- Juice Goose KIN-1000 UPS
-- Joshua Small
-- 2026-09-23
--[[
  Juice Goose KIN-1000 UPS - Q-SYS Plugin
  ---------------------------------------------------------------------------
  Implements the binary RS-232 protocol from "KIN-1000 and RS-232
  Communications Protocol.txt". This is a much thinner, older-style protocol
  than an ASCII command set: single raw bytes are sent, and the UPS echoes a
  fixed 16-byte binary status block in response to a poll byte.

  READ THIS FIRST - the source document has real gaps/likely errors, more so
  than a typical vendor protocol spec, so please treat the items below as
  things to verify on the bench before relying on this in the field:

  1) LINE SETTINGS: the document says "BPS = 1200, 1 START BIT, 1 END BIT,
     16 DATA BIT". 16 data bits is not a real UART configuration (nothing,
     including Q-SYS's serial port, supports it), so this is almost
     certainly an OCR/transcription artifact of the original "8 DATA BIT".
     This plugin opens the port at 1200 baud, 8 data bits, no parity, 1 stop
     bit (8N1). If the unit does not respond, this is the first thing to
     double check against Juice Goose directly.

  2) NO ACKS: only the poll command (byte value 1) has a documented
     response (16 raw bytes). Self-test, enable/disable AC-normal-restart,
     wake-up-time, and pre-shutdown-count are implemented as fire-and-forget
     writes with a short pacing delay before the next command, since the
     document defines no response for them.

  3) UNITS: the doc lists load/battery as raw bytes and calls them "load
     level" / "battery level" with no scale given; input/output voltage and
     frequency are likewise raw bytes with no scale given. This plugin
     displays load and battery as raw byte values. Voltage and frequency
     are shown with inferred V/Hz units.
--]]
-- Health colors follow Q-SYS Status; modes/activity use neutral gray.
IndicatorGreen = {0, 159, 60}
IndicatorRed = {223, 0, 36}
IndicatorOrange = {230, 171, 56}
IndicatorNeutral = {128, 128, 128}
IndicatorRedHex = "#DF0024"
IndicatorOrangeHex = "#E6AB38"

PluginInfo = {
  Name = "Juice Goose~KIN-1000",
  Version = "1.0.0.26",
  BuildVersion = "1.0.0.26",
  Id = "f231dbeb-8be6-43ca-aa5c-b65359543d90",
  Author = "Joshua Small",
  Manufacturer = "Juice Goose",
  Model = "KIN-1000",
  Description = "RS-232 control and monitoring for the Juice Goose KIN-1000 UPS: load/battery levels, input/output voltage and frequency, AVR/overload/fault/battery/test-mode status, self-test, AC-normal-restart enable/disable, wake-up timer, and pre-shutdown countdown, per the KIN-1000 binary RS-232 protocol.",
  ShowDebug = true,
}

BrandColor = {14, 13, 221}
White = {255, 255, 255}
PanelGray = {230, 230, 230}
ReadoutGray = {194, 194, 194}
Black = {0, 0, 0}
OutlineGray = {128, 128, 128}
LogoImage = ""

function GetColor(props)
  return BrandColor
end

function GetPrettyName(props)
  return "Juice Goose \x1DKIN-1000"
end

function GetProperties()
  local props = {}
  table.insert(
    props,
    {
      Name = "Poll Interval (s)",
      Type = "integer",
      Min = 2,
      Max = 60,
      Value = 5
      --[[     Comment = "Tx Status-poll byte (0x01), Rx 16-byte status block." ]]
    }
  )
  table.insert(
    props,
    {
      Name = "Debug Print",
      Type = "enum",
      Choices = {"None", "Tx", "Rx", "Tx/Rx", "Function Calls", "All"},
      Value = "None"
    }
  )
  return props
end

function RectifyProperties(props)
  if props["plugin_show_debug"] and props["plugin_show_debug"].Value == false then
    props["Debug Print"].IsHidden = true
  end
  return props
end

function GetPins(props)
  local pins = {}
  table.insert(
    pins,
    {
      Name = "Serial Port",
      Direction = "input",
      Domain = "serial"
    }
  )
  return pins
end

