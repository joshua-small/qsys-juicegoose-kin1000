function GetControlLayout(props)
  if props.page_index and props.page_index.Value == 2 then
    return GetControlsLayout(props)
  end
  return GetSetupLayout(props)
end

--=============================================================================
-- Run-time
--=============================================================================
if Controls then
  --*** Control aliases ***
  Status = Controls.ConnectionStatus

  --*** Variables ***
  PollInterval = Properties["Poll Interval (s)"].Value
  DebugTx = false
  DebugRx = false
  DebugFunctions = false
  Busy = false
  PendingExpectBytes = nil
  ReceiveBuffer = ""
  InvalidFrameReported = false
  ClosingForRetry = false

  --*** Objects and tables ***
  SerialPort = SerialPorts[1]
  CmdQueue = {}
  PollTimer = Timer.New()
  CmdTimeoutTimer = Timer.New()
  RetryTimer = Timer.New()
  StartupTimer = Timer.New()
  Readings = {
    "LoadLevel", "BatteryLevel", "InputVoltage", "OutputVoltage",
    "InputFrequency", "OutputFrequency", "AVRMode", "NominalVoltage",
    "ShutdownModeDisplay"
  }
  Indicators = {
    "SystemFault", "OnBattery", "LowBattery", "AVRActive", "Overload",
    "Fault", "BatteryBad", "TestMode", "PreSDCountActive",
    "ScheduleCountActive", "NoLoadShutdownDisabled"
  }

  --*** Constants ***
  StatusState = {
    OK = 0,
    COMPROMISED = 1,
    FAULT = 2,
    NOTPRESENT = 3,
    MISSING = 4,
    INITIALIZING = 5
  }
  RetryInterval = 5
  ResponseTimeout = 2
  CommandQuietTime = 0.3
  NominalVoltages = {
    [0] = "100V", [1] = "110V", [2] = "115V", [3] = "120V",
    [7] = "200V", [8] = "220V", [9] = "230V", [10] = "240V"
  }

  --*** Recommended runtime functions and helpers ***
  function Log(msg)
    print(msg)
  end

  function Trace(msg)
    if DebugFunctions then
      print("CALL: " .. msg)
    end
  end

  function SetupDebugPrint()
    local debugPrint = Properties["Debug Print"].Value
    DebugTx = debugPrint == "Tx" or debugPrint == "Tx/Rx" or debugPrint == "All"
    DebugRx = debugPrint == "Rx" or debugPrint == "Tx/Rx" or debugPrint == "All"
    DebugFunctions = debugPrint == "Function Calls" or debugPrint == "All"
  end

  function HexDump(data)
    local parts = {}
    for i = 1, #data do
      parts[#parts + 1] = string.format("%02X", string.byte(data, i))
    end
    return table.concat(parts, " ")
  end

  function ClearReadings()
    for _, name in ipairs(Readings) do
      Controls[name].String = ""
    end
    for _, name in ipairs(Indicators) do
      Controls[name].Boolean = false
    end
  end

  function ClearVariables()
    Trace("ClearVariables()")
    PollTimer:Stop()
    CmdTimeoutTimer:Stop()
    CmdQueue = {}
    Busy = false
    PendingExpectBytes = nil
    ReceiveBuffer = ""
    InvalidFrameReported = false
    ClearReadings()
  end

  function ScheduleRetry()
    RetryTimer:Stop()
    RetryTimer:Start(RetryInterval)
  end

  function Disconnected(reason, message)
    Trace("Disconnected(" .. reason .. ")")
    ClearVariables()
    if ClosingForRetry then
      return
    end
    Status.Value = reason == "Error" and StatusState.FAULT or StatusState.MISSING
    Status.String = "Serial " .. reason:lower()
    Log("Serial " .. reason:lower() .. (message and message ~= "" and (": " .. message) or ""))
    ScheduleRetry()
  end

  function OpenSerialPort()
    Trace("OpenSerialPort()")
    RetryTimer:Stop()
    local opened, err = pcall(function()
      if SerialPort.IsOpen then
        ClosingForRetry = true
        SerialPort:Close()
        ClosingForRetry = false
      end
      SerialPort:Open(1200, 8, "N", 1)
    end)
    ClosingForRetry = false
    if not opened then
      ClearVariables()
      Status.Value = StatusState.FAULT
      Status.String = "Serial port open failed"
      Log("Serial port open failed: " .. tostring(err))
      ScheduleRetry()
    end
  end

  function AdvanceQueue()
    Busy = false
    PendingExpectBytes = nil
    ReceiveBuffer = ""
    CmdTimeoutTimer:Stop()
    ServiceQueue()
  end

  function ServiceQueue()
    if Busy or #CmdQueue == 0 then
      return
    end
    if not SerialPort.IsOpen then
      Disconnected("Closed", "Unable to write: port closed")
      return
    end
    local item = table.remove(CmdQueue, 1)
    Busy = true
    PendingExpectBytes = item.expectBytes
    ReceiveBuffer = ""
    InvalidFrameReported = false
    if DebugTx then
      print("TX: " .. HexDump(item.data))
    end
    CmdTimeoutTimer:Start(item.expectBytes and ResponseTimeout or CommandQuietTime)
    local written, err = pcall(function()
      SerialPort:Write(item.data)
    end)
    if not written then
      Disconnected("Error", "Write failed: " .. tostring(err))
    end
  end

  function Send(cmd, expectBytes)
    Trace("Send(" .. HexDump(cmd) .. ")")
    if not SerialPort.IsOpen then
      Log("Unable to send command: serial port closed")
      return
    end
    CmdQueue[#CmdQueue + 1] = {data = cmd, expectBytes = expectBytes}
    ServiceQueue()
  end

  function PollDevice()
    Trace("PollDevice()")
    Send(string.char(0x01), 16)
  end

  function SelfTest()
    Trace("SelfTest()")
    Send(string.char(0x03))
  end

  function EnableACRestart()
    Trace("EnableACRestart()")
    Send(string.char(0xB9))
  end

  function DisableACRestart()
    Trace("DisableACRestart()")
    Send(string.char(0xBA))
  end

  function SetWakeUp(minutes)
    minutes = math.floor(math.max(0, math.min(1440, minutes or 0)))
    Trace("SetWakeUp(" .. minutes .. ")")
    local highByte = math.floor(minutes / 256)
    local lowByte = minutes % 256
    Send(string.char(0x04, highByte, lowByte))
  end

  function SetPreSD(minutes, seconds)
    minutes = math.floor(math.max(0, math.min(255, minutes or 0)))
    seconds = math.floor(math.max(0, math.min(255, seconds or 0)))
    Trace("SetPreSD(" .. minutes .. ", " .. seconds .. ")")
    Send(string.char(0xBC, minutes, seconds))
  end

  -- Static model information is included in the status block, not a separate command.
  function GetDeviceInfo(modelByte)
    Trace("GetDeviceInfo()")
    local voltageCode = modelByte & 0x0F
    Controls.NominalVoltage.String = NominalVoltages[voltageCode] or ("Unknown (code " .. voltageCode .. ")")
  end

  function IsValidResponse(data)
    return #data == 16 and string.byte(data, 6) == 0xFF and (string.byte(data, 11) & 0x80) ~= 0
  end

  function ParsePollResponse(data)
    Trace("ParsePollResponse()")
    if not IsValidResponse(data) then
      return false
    end
    local b = {}
    for i = 0, 15 do
      b[i] = string.byte(data, i + 1)
    end

    Controls.LoadLevel.String = tostring(b[0])
    Controls.BatteryLevel.String = tostring(b[1])
    Controls.InputVoltage.String = b[2] .. " V"
    Controls.OutputVoltage.String = b[3] .. " V"
    Controls.InputFrequency.String = b[4] .. " Hz"
    Controls.OutputFrequency.String = b[6] .. " Hz"

    local f9 = b[9]
    -- Byte 9 bit 7 is SD MODE DISPLAY; the protocol does not name its states.
    Controls.ShutdownModeDisplay.String = (f9 & 0x80) ~= 0 and "Set" or "Clear"
    local onBattery = (f9 & 0x01) ~= 0
    local lowBattery = (f9 & 0x02) ~= 0
    local avrActive = (f9 & 0x08) ~= 0
    local avrBoost = (f9 & 0x10) ~= 0
    local overload = (f9 & 0x20) ~= 0

    Controls.OnBattery.Boolean = onBattery
    Controls.LowBattery.Boolean = lowBattery
    Controls.AVRActive.Boolean = avrActive
    Controls.AVRMode.String = avrActive and (avrBoost and "Boost" or "Buck") or "-"
    Controls.Overload.Boolean = overload

    local f10 = b[10]
    local fault = (f10 & 0x01) ~= 0
    local batBad = (f10 & 0x02) ~= 0
    local testMode = (f10 & 0x04) ~= 0
    local preSD = (f10 & 0x10) ~= 0
    local schedCount = (f10 & 0x20) ~= 0
    local noLoadDis = (f10 & 0x40) ~= 0

    Controls.Fault.Boolean = fault
    Controls.BatteryBad.Boolean = batBad
    Controls.TestMode.Boolean = testMode
    Controls.PreSDCountActive.Boolean = preSD
    Controls.ScheduleCountActive.Boolean = schedCount
    Controls.NoLoadShutdownDisabled.Boolean = noLoadDis

    GetDeviceInfo(b[12])

    Controls.SystemFault.Boolean = fault or batBad or overload or lowBattery
    -- Preserve the existing output truth table; low battery is reduced service.
    Controls.SystemFault.Color = lowBattery and not (fault or batBad or overload)
      and IndicatorOrangeHex or IndicatorRedHex

    -- A successful poll confirms communication, not necessarily healthy power.
    local problems = {}
    if fault then
      table.insert(problems, "UPS fault")
    end
    if batBad then
      table.insert(problems, "Bad battery")
    end
    if overload then
      table.insert(problems, "Overload")
    end
    if #problems > 0 then
      Status.Value = StatusState.FAULT
    elseif onBattery or lowBattery then
      Status.Value = StatusState.COMPROMISED
    else
      Status.Value = StatusState.OK
    end
    if onBattery then
      table.insert(problems, "On battery")
    end
    if lowBattery then
      table.insert(problems, "Low battery")
    end
    if avrActive then
      table.insert(problems, "AVR regulating input")
    end
    Status.String = #problems > 0 and table.concat(problems, "; ") or "Connected"
    return true
  end

  -- Fixed-length binary framing: CR/LF can occur inside the response.
  -- Slide over bad bytes until both documented markers match. This is not a checksum.
  function ParseResponse()
    local data = SerialPort:Read(SerialPort.BufferLength)
    if not data or #data == 0 then
      return
    end
    if DebugRx then
      print("RX: " .. HexDump(data))
    end
    if not Busy or not PendingExpectBytes then
      Trace("ParseResponse(): ignoring unsolicited data")
      return
    end
    ReceiveBuffer = ReceiveBuffer .. data
    while #ReceiveBuffer >= 16 do
      local frame = ReceiveBuffer:sub(1, 16)
      if IsValidResponse(frame) then
        ParsePollResponse(frame)
        AdvanceQueue()
        return
      end
      ReceiveBuffer = ReceiveBuffer:sub(2)
      if not InvalidFrameReported then
        Log("Invalid poll response; searching for a valid frame")
        InvalidFrameReported = true
      end
    end
  end

  function Connect()
    Trace("Connect()")
    RetryTimer:Stop()
    ClearVariables()
    Status.Value = StatusState.INITIALIZING
    Status.String = "Serial open; awaiting valid poll"
    Log("Serial port connected")
    PollTimer:Start(PollInterval)
    PollDevice()
  end

  --*** Event handlers ***
  StartupTimer.EventHandler = function()
    StartupTimer:Stop()
    OpenSerialPort()
  end
  RetryTimer.EventHandler = function()
    RetryTimer:Stop()
    OpenSerialPort()
  end
  PollTimer.EventHandler = function()
    if not Busy and #CmdQueue == 0 then
      PollDevice()
    end
  end
  CmdTimeoutTimer.EventHandler = function()
    CmdTimeoutTimer:Stop()
    if PendingExpectBytes then
      ClearReadings()
      Status.Value = StatusState.MISSING
      Status.String = "No valid poll response"
      Log("No valid response to status poll")
      if SerialPort.IsOpen and SerialPort.BufferLength > 0 then
        SerialPort:Read(SerialPort.BufferLength)
      end
    end
    AdvanceQueue()
  end
  SerialPort.Data = ParseResponse
  SerialPort.Connected = Connect
  SerialPort.Closed = function()
    Disconnected("Closed")
  end
  SerialPort.Error = function(_, message)
    Disconnected("Error", message)
  end
  SerialPort.Timeout = function()
    Disconnected("Timeout")
  end
  SerialPort.Reconnect = function()
    Log("Serial port reconnecting")
  end
  Controls.SelfTestBtn.EventHandler = function(ctl)
    if ctl.Value == 1 then
      SelfTest()
    end
  end
  Controls.EnableACRestartBtn.EventHandler = function(ctl)
    if ctl.Value == 1 then
      EnableACRestart()
    end
  end
  Controls.DisableACRestartBtn.EventHandler = function(ctl)
    if ctl.Value == 1 then
      DisableACRestart()
    end
  end
  Controls.SetWakeUpBtn.EventHandler = function(ctl)
    if ctl.Value == 1 then
      SetWakeUp(Controls.WakeUpMinutes.Value)
    end
  end
  Controls.SetPreSDBtn.EventHandler = function(ctl)
    if ctl.Value == 1 then
      SetPreSD(Controls.PreSDMinutes.Value, Controls.PreSDSeconds.Value)
    end
  end

  --*** Initialization ***
  function Initialization()
    SetupDebugPrint()
    print(PluginInfo.Name .. " v" .. PluginInfo.Version)
    Trace("Initialization()")
    ClearVariables()
    Status.Value = StatusState.INITIALIZING
    Status.String = "Initializing..."
    StartupTimer:Start(1)
  end

  Initialization()
end
